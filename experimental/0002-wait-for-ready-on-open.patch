@@ -390,6 +391,86 @@ elanmoc2_cancel (FpDevice *device)
   elanmoc2_cmd_transceive (device, &cmd_abort, buffer_out);
 }
 
+enum {
+  OPEN_GET_STATUS,
+  OPEN_CHECK_STATUS,
+  OPEN_NUM_STATES
+};
+
+/* Right after being opened (and reset) with a finger resting on it,
+ * 04f3:0c77 is not ready: it answers the first command with six zero bytes
+ * and can stop answering altogether. Poll the status query, as the elanmoc
+ * driver does, until the sensor reports ready. */
+static void
+elanmoc2_open_run_state (FpiSsm *ssm, FpDevice *device)
+{
+  FpiDeviceElanMoC2 *self = FPI_DEVICE_ELANMOC2 (device);
+
+  g_autoptr(GBytes) buffer_in = g_steal_pointer (&self->buffer_in);
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case OPEN_GET_STATUS: {
+        g_autoptr(GByteArray) buffer_out =
+          elanmoc2_prepare_cmd (self, &cmd_get_status);
+
+        if (buffer_out == NULL)
+          {
+            fpi_ssm_mark_completed (g_steal_pointer (&self->ssm));
+            break;
+          }
+        elanmoc2_cmd_transceive (device, &cmd_get_status, buffer_out);
+        break;
+      }
+
+    case OPEN_CHECK_STATUS: {
+        gsize len = buffer_in != NULL ? g_bytes_get_size (buffer_in) : 0;
+        const guint8 *data =
+          buffer_in != NULL ? g_bytes_get_data (buffer_in, NULL) : NULL;
+
+        self->ready_polls++;
+
+        if (len >= 2 && data[1] == ELANMOC2_RESP_READY)
+          {
+            if (self->ready_polls > 1)
+              fp_warn ("Sensor ready after %u status polls", self->ready_polls);
+            else
+              fp_info ("Sensor ready");
+            fpi_ssm_mark_completed (g_steal_pointer (&self->ssm));
+            break;
+          }
+
+        if (len >= 2)
+          fp_warn ("Sensor not ready, status 0x%02x 0x%02x (poll %u)",
+                   data[0], data[1], self->ready_polls);
+        else
+          fp_warn ("Sensor not ready, no status (poll %u)", self->ready_polls);
+
+        if (self->ready_polls >= ELANMOC2_READY_RETRIES)
+          {
+            fp_warn ("Sensor never reported ready, continuing anyway");
+            fpi_ssm_mark_completed (g_steal_pointer (&self->ssm));
+            break;
+          }
+        fpi_ssm_jump_to_state_delayed (ssm, OPEN_GET_STATUS,
+                                       ELANMOC2_READY_DELAY_MS);
+        break;
+      }
+
+    default:
+      break;
+    }
+}
+
+static void
+elanmoc2_open_ssm_completed (FpiSsm *ssm, FpDevice *device, GError *error)
+{
+  if (error != NULL)
+    g_usb_device_release_interface (fpi_device_get_usb_device (device),
+                                    0, 0, NULL);
+  fpi_device_open_complete (device, error);
+}
+
 static void
 elanmoc2_open (FpDevice *device)
 {
@@ -432,7 +513,16 @@ elanmoc2_open (FpDevice *device)
         }
     }
   fpi_device_set_nr_enroll_stages (device, self->enroll_times);
-  fpi_device_open_complete (device, NULL);
+
+  if (!(self->dev_type & ELANMOC2_QUIRK_WAIT_READY))
+    {
+      fpi_device_open_complete (device, NULL);
+      return;
+    }
+
+  self->ready_polls = 0;
+  self->ssm = fpi_ssm_new (device, elanmoc2_open_run_state, OPEN_NUM_STATES);
+  fpi_ssm_start (self->ssm, elanmoc2_open_ssm_completed);
 }
 
 static void
@@ -1324,7 +1414,8 @@ static const FpIdEntry elanmoc2_id_table[] = {
   {.vid = ELANMOC2_VEND_ID, .pid = 0x0c5e, .driver_data = ELANMOC2_DEV_0C5E},
   {.vid = ELANMOC2_VEND_ID, .pid = 0x0c77,
    .driver_data = ELANMOC2_QUIRK_NO_WIPE_FALLBACK |
-                  ELANMOC2_QUIRK_ARM_M4_ENROLL},
+                  ELANMOC2_QUIRK_ARM_M4_ENROLL |
+                  ELANMOC2_QUIRK_WAIT_READY},
   {.vid = ELANMOC2_VEND_ID, .pid = 0x0c7c, .driver_data = ELANMOC2_ALL_DEV},
   {.vid = ELANMOC2_VEND_ID, .pid = 0x0c90, .driver_data = ELANMOC2_ALL_DEV},
   {.vid = 0, .pid = 0, .driver_data = 0}
